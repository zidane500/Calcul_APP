<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- La licence ne doit JAMAIS être restaurée sur un autre téléphone. -->
        <exclude domain="sharedpref" path="license_prefs.xml" />
        <exclude domain="sharedpref" path="sauvegarde_auto_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="license_prefs.xml" />
        <exclude domain="sharedpref" path="sauvegarde_auto_prefs.xml" />
    </device-transfer>
</data-extraction-rules>