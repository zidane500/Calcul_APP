<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- CONTENU PRINCIPAL -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <include layout="@layout/layout_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/background"
        android:fillViewport="true"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Groupes de poteaux -->
            <LinearLayout
                android:id="@+id/layoutGroupesPoteaux"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Ajouter un autre poteau -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAjouterPoteau"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="@string/ajouter_poteau"
                android:textAllCaps="false"
                android:textColor="@color/add_poteau_text"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@color/add_poteau_background"
                app:cornerRadius="12dp"
                app:elevation="0dp"
                app:icon="@drawable/ic_add_poteau"
                app:iconGravity="textStart"
                app:iconPadding="7dp"
                app:iconSize="19dp"
                app:iconTint="@color/add_poteau_text"
                app:strokeColor="@color/add_poteau_stroke"
                app:strokeWidth="1dp" />

            <!-- Calculer -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalculer"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="24dp"
                android:minHeight="0dp"
                android:text="@string/calculer"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary"
                app:cornerRadius="14dp"
                app:elevation="2dp"
                app:icon="@drawable/ic_calculate"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconSize="20dp"
                app:iconTint="@color/white" />

            <!-- ============================= -->
            <!-- CARD RÉSULTATS -->
            <!-- ============================= -->

            <androidx.cardview.widget.CardView
                android:id="@+id/cardResultats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardUseCompatPadding="false">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="16dp">

                    <!-- En-tête -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:text="@string/resultats"
                            android:textColor="@color/primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:includeFontPadding="false"
                            android:text="Synthèse du calcul et optimisation"
                            android:textColor="@color/secondary_text"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- Séparateur -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="@color/divider" />

                    <!-- Boutons d'export -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExporterPdf"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="Exporter PDF"
                            android:textAllCaps="false"
                            android:textColor="@color/on_surface"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/pdf_color"
                            app:cornerRadius="10dp"
                            app:elevation="0dp"
                            app:icon="@drawable/ic_pdf_export"
                            app:iconGravity="textStart"
                            app:iconPadding="5dp"
                            app:iconSize="16dp"
                            app:iconTint="@color/on_surface" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExporterExcel"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:text="Exporter Excel"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/excel_color"
                            app:cornerRadius="10dp"
                            app:elevation="0dp"
                            app:icon="@drawable/ic_excel_export"
                            app:iconGravity="textStart"
                            app:iconPadding="5dp"
                            app:iconSize="16dp"
                            app:iconTint="@color/white" />

                    </LinearLayout>

                    <!-- Séparateur -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"
                        android:background="@color/divider" />

                    <!-- Résultat général -->
                    <TextView
                        android:id="@+id/tvResultats"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="4dp"
                        android:textColor="#343A40"
                        android:textSize="14sp" />

                    <!-- Résultats par type de barre -->
                    <LinearLayout
                        android:id="@+id/layoutResultatsBarres"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="vertical" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>



    </ScrollView>
    </LinearLayout>

    <!-- MENU LATÉRAL -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>