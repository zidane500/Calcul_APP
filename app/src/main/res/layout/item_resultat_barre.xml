<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="10dp">


    <!-- ===================================================== -->
    <!-- RÉSUMÉ DE LA BARRE                                   -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/tvResumeBarre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:lineSpacingExtra="4dp"
        android:textColor="#343A40"
        android:textSize="14sp" />


    <!-- ===================================================== -->
    <!-- BOUTON AFFICHER / MASQUER LE DÉTAIL                  -->
    <!-- ===================================================== -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAfficherDetail"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="13dp"
        android:paddingEnd="11dp"
        android:text="Afficher le détail"
        android:textAllCaps="false"
        android:textColor="@color/detail_button_text"
        android:textSize="13sp"
        android:textStyle="bold"
        app:backgroundTint="@color/detail_button_background"
        app:cornerRadius="10dp"
        app:elevation="0dp"
        app:icon="@drawable/ic_chevron_down"
        app:iconGravity="textEnd"
        app:iconPadding="6dp"
        app:iconSize="16dp"
        app:iconTint="@color/detail_button_text"
        app:strokeColor="@color/detail_button_stroke"
        app:strokeWidth="1dp" />


    <!-- ===================================================== -->
    <!-- DÉTAIL DES BARRES                                    -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/tvDetailBarres"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:includeFontPadding="false"
        android:lineSpacingExtra="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textColor="#495057"
        android:textSize="13sp"
        android:visibility="gone" />

</LinearLayout>