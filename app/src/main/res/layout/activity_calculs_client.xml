<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FA"
    android:orientation="vertical">

    <include layout="@layout/layout_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/tvInfoClient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textColor="#526176"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="@string/client_nouveau_calcul"
                android:textColor="#17263C"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Poteau : action principale -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCalculerPoteau"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginBottom="12dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/calculer_poteau"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="#173B65"
                app:cornerRadius="18dp"
                app:icon="@drawable/ic_poteau"
                app:iconGravity="textStart"
                app:iconPadding="12dp"
                app:iconSize="28dp"
                app:iconTint="#FFFFFF" />

            <!-- Ligne 1 : Pré-poteau / Dalle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCalculerPrePoteau"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="2"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/calculer_pre_poteau"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#3E6B63"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_pre_poteau"
                    app:iconGravity="textTop"
                    app:iconPadding="8dp"
                    app:iconSize="28dp"
                    app:iconTint="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCalculerDalle"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="2"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/calculer_dalle"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#251603"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_dalle"
                    app:iconGravity="textTop"
                    app:iconPadding="8dp"
                    app:iconSize="28dp"
                    app:iconTint="#FFFFFF" />

            </LinearLayout>

            <!-- Ligne 2 : Semelle / Poutre -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCalculerSemelle"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="2"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/calculer_semelle"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#54413A"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_semelle"
                    app:iconGravity="textTop"
                    app:iconPadding="8dp"
                    app:iconSize="28dp"
                    app:iconTint="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCalculerPoutre"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="2"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/calculer_poutre"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#2E4A62"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_poutre"
                    app:iconGravity="textTop"
                    app:iconPadding="8dp"
                    app:iconSize="28dp"
                    app:iconTint="#FFFFFF" />

            </LinearLayout>

            <!-- Ligne 3 : Chaînage / Multi-Calcul -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCalculerChainage"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="2"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/calculer_chainage"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#7A2E3A"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_chainage"
                    app:iconGravity="textTop"
                    app:iconPadding="8dp"
                    app:iconSize="28dp"
                    app:iconTint="#FFFFFF" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCalculerMulti"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:maxLines="2"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/multi_calcul"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#5B3E8E"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_calculate"
                    app:iconGravity="textTop"
                    app:iconPadding="8dp"
                    app:iconSize="28dp"
                    app:iconTint="#FFFFFF" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="14dp"
                android:text="@string/client_calculs_enregistres"
                android:textColor="#17263C"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAucunCalcul"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/aucun_calcul_client"
                android:textColor="#526176"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutCalculs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>