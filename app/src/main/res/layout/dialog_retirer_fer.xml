<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/type_fer"
        android:textColor="#444444" />

    <Spinner
        android:id="@+id/spinnerTypeRetrait"
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/longueur_morceau"
        android:textColor="#444444" />

    <Spinner
        android:id="@+id/spinnerLongueurRetrait"
        android:layout_width="match_parent"
        android:layout_height="48dp" />

    <TextView
        android:id="@+id/txtLabelRequise"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/longueur_requise"
        android:textColor="#444444" />

    <EditText
        android:id="@+id/editLongueurRequise"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/exemple_longueur"
        android:inputType="numberDecimal"
        android:textColor="#000000"
        android:textColorHint="#888888" />

    <TextView
        android:id="@+id/txtResteRetrait"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#2E7D32"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtDisponible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="#444444" />

    <EditText
        android:id="@+id/editNombreRetrait"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/nombre_morceaux_retirer"
        android:inputType="number"
        android:textColor="#000000"
        android:textColorHint="#888888" />

    <TextView
        android:id="@+id/txtErreurRetrait"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#C62828"
        android:visibility="gone" />
</LinearLayout>