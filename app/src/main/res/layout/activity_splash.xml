<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@color/splash_fond">
    <!--  Logo en grand, sans cercle : le fond de l'image est exactement celui de l'écran  -->
    <ImageView android:id="@+id/ivLogoSplash" android:layout_width="300dp" android:layout_height="273dp" android:contentDescription="@string/app_name" android:scaleType="fitCenter" android:src="@drawable/logo_splash"/>
    <TextView android:id="@+id/tvNomAppSplash" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:alpha="0" android:text="@string/app_name" android:textColor="@color/white" android:textSize="22sp" android:textStyle="bold"/>
</LinearLayout>