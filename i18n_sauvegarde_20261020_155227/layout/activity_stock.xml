<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background">

        <include layout="@layout/layout_header" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Ajouter du fer -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAjouterFer"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginBottom="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Ajouter Fer"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="14dp"
                    app:elevation="3dp"
                    app:icon="@drawable/ic_btn_ajouter"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconSize="22dp"
                    app:iconTint="@color/white" />

                <!-- Historique -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHistoriqueStock"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="12dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Historique"
                    android:textAllCaps="false"
                    android:textColor="@color/add_poteau_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/add_poteau_background"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_btn_historique"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/add_poteau_text"
                    app:strokeColor="@color/add_poteau_stroke"
                    app:strokeWidth="1dp" />

                <!-- Retirer du fer -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRetirerFer"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="24dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="Retirer Fer"
                    android:textAllCaps="false"
                    android:textColor="@color/retirer_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/retirer_background"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_btn_retirer"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/retirer_text"
                    app:strokeColor="@color/retirer_stroke"
                    app:strokeWidth="1dp" />

                <!-- Filtre placé AVANT la liste du stock -->
                <LinearLayout
                    android:id="@+id/layoutFiltreStock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="8dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_filter"
                            app:tint="@color/secondary_text" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Filtrer par type de fer"
                            android:textColor="@color/section_title"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:scrollbars="none">

                        <!-- Boutons de filtre ajoutés par StockActivity.java -->
                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupFiltre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="8dp"
                            app:selectionRequired="true"
                            app:singleLine="true"
                            app:singleSelection="true" />

                    </HorizontalScrollView>

                </LinearLayout>

                <!-- Message lorsque le stock est vide -->
                <TextView
                    android:id="@+id/tvStockVide"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="Aucun fer en stock pour l'instant."
                    android:textColor="@color/on_surface"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- Liste du stock -->
                <LinearLayout
                    android:id="@+id/layoutStock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>